{
  "name": "fabric-trivia-rayfin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": "./rayfin/.temp/compiled/data/schema.js",
  "scripts": {
    "dev": "rayfin dev",
    "dev:frontend": "npm run entry:generate && vite --host 127.0.0.1 --port 5173",
    "names:generate": "node scripts/generate-player-names.mjs",
    "countries:generate": "node scripts/generate-countries.mjs",
    "entry:generate": "npm run names:generate && npm run countries:generate",
    "build": "npm run entry:generate && tsc -b && vite build",
    "build:functions": "npm --prefix rayfin/functions run build",
    "build:schema": "tsc -b rayfin/tsconfig.json",
    "schema:check": "node scripts/check-schema.mjs",
    "test": "npm run entry:generate && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css}\"",
    "preview": "vite preview",
    "type-check": "npm run entry:generate && tsc -b"
  },
  "dependencies": {
    "@fabric-msft/svg-icons": "^4.0.3",
    "@microsoft/rayfin-auth-provider-fabric": "1.35.1",
    "@microsoft/rayfin-client": "1.35.1",
    "@microsoft/rayfin-core": "1.35.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.548.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-qr-code": "^2.0.18",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@microsoft/rayfin-cli": "1.35.1",
    "@tailwindcss/postcss": "^4.1.16",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.3",
    "@types/jest": "^29.5.12",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "postcss": "^8.5.23",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.16",
    "tailwindcss-animate": "^1.0.7",
    "ts-jest": "^29.3.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.3.5"
  }
}
